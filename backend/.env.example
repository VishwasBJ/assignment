# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_code_review?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development

# CORS - Frontend URL
FRONTEND_URL="http://localhost:3000"

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR="./uploads"
